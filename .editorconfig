# .editorconfig — BlindPath 代码风格统一配置
# ktlint 会读取此文件，无需额外 .ktlint 配置文件

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_size = 4
ij_kotlin_imports_layout = *,java.**,javax.**,kotlin.**,^
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
# 最大行长 120，与 detekt 配置一致
max_line_length = 120

[*.{xml,html}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.json]
indent_size = 2

[*.{md,txt}]
trim_trailing_whitespace = false
