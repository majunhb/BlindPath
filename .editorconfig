# ktlint 配置文件
# https://pinterest.github.io/ktlint/

# 缩进大小
indent_size = 4

# 最大行长度
max_line_length = 120

# 续行缩进
continuation_indent_size = 8

# 导入排序
ktlint_code_style = android_studio

# 禁用的规则
disabled_rules = [
    # 允许使用 wildcard 导入
    no-wildcard-imports,
    
    # 允许文件末尾有空行
    final-newline,
    
    # 允许使用分号
    no-semi,
]

# 启用的规则
enabled_rules = [
    # 强制使用大括号
    multi-if-else,
    
    # 禁止使用空代码块
    no-empty-first-line-in-method-block,
    
    # 强制换行
    chain-wrapping,
    
    # 参数换行
    argument-list-wrapping,
    
    # 多重条件换行
    multiline-if-else,
    
    # 字符串模板
    string-template,
    
    # 禁止使用不必要的括号
    unnecessary-parentheses-before-trailing-lambda,
]

# 实验性规则
ktlint_experimental = enabled

# 文件名规则
[*.{kt,kts}]
indent_style = space
