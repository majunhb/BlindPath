# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/

# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ
*.iml
.idea/

# Keystore files
*.jks
*.keystore

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx/

# Version control
vcs.xml

# lint
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/

# Mac
.DS_Store

# 真实凭证文件（包含敏感密钥）
**/credentials.properties
!**/credentials.properties.template

# 本地配置文件
local.properties
secrets.properties

# 高德地图 API Key（在 AndroidManifest.xml 中）
# 注意：AndroidManifest.xml 中的 API Key 也需要通过 CI Secrets 注入

# CI 触发标记
.trigger_marker

# 二进制文档
*.docx

# OS files
Thumbs.db
apk/*.zip

# Native libraries (.so) — 大文件，建议用 Git LFS 管理
*.so

# AI/ML 模型文件 — 大文件，建议用 Git LFS 或外部存储
*.tflite
*.pcm
*.bin

# SDK 二进制 — 已在 *.aar 中覆盖，此处保留以防遗漏
module_voice/libs/*.aar
app/libs/*.aar
