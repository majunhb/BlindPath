<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 允许明文传输（用于开发环境） -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    
    <!-- 生产环境应使用更严格的配置 -->
